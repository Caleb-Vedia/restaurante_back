DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=restaurante_db

PORT=3000

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origen exacto del frontend para CORS. NUNCA '*': el navegador rechaza el
# wildcard cuando la respuesta usa credenciales (cookie de sesión).
FRONTEND_URL=http://localhost:5173

# 'production' activa el flag Secure de la cookie de sesión (requiere HTTPS).
NODE_ENV=development

# Solo para src/database/seeds/create-admin.seed.ts (script manual, no vía API)
SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=